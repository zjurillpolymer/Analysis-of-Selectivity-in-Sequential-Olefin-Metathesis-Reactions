; GAFF2 explicit-DCM energy minimization
integrator               = steep
nsteps                   = 50000
emtol                    = 100.0
emstep                   = 0.01
cutoff-scheme            = Verlet
nstlist                  = 20
rlist                    = 1.2
coulombtype              = PME
rcoulomb                 = 1.2
vdwtype                  = Cut-off
rvdw                     = 1.2
DispCorr                 = EnerPres
pbc                      = xyz
constraints              = h-bonds
constraint-algorithm     = lincs
lincs-iter               = 1
lincs-order              = 4
