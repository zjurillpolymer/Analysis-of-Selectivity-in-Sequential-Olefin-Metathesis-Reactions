; 1 ns density equilibration; C-rescale samples the NPT ensemble
integrator               = md
dt                       = 0.002
nsteps                   = 500000
continuation             = yes
constraint-algorithm     = lincs
constraints              = h-bonds
lincs-iter               = 1
lincs-order              = 4
cutoff-scheme            = Verlet
nstlist                  = 20
rlist                    = 1.2
coulombtype              = PME
rcoulomb                 = 1.2
pme-order                = 4
fourierspacing           = 0.12
vdwtype                  = Cut-off
rvdw                     = 1.2
DispCorr                 = EnerPres
tcoupl                   = V-rescale
tc-grps                  = System
tau-t                    = 1.0
ref-t                    = 313.15
pcoupl                   = C-rescale
pcoupltype               = isotropic
tau-p                    = 5.0
ref-p                    = 1.0
compressibility          = 1.0e-4
gen-vel                  = no
nstxout                  = 0
nstvout                  = 0
nstfout                  = 0
nstxout-compressed       = 0
compressed-x-precision   = 1000
nstenergy                = 500
nstlog                   = 5000
nstcalcenergy            = 100
pbc                      = xyz
comm-mode                = Linear
nstcomm                  = 100
